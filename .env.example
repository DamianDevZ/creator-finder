# Get one free at https://console.cloud.google.com/ -> enable "YouTube Data API v3"
YOUTUBE_API_KEY=

# Optional: AI-written channel notes. Free tier at https://aistudio.google.com/
# (~15 req/min, 1500/day on gemini-flash — one batched call per scan)
GEMINI_API_KEY=

# Optional: shared cache + accounts/list sync. Service key is server-side only —
# never expose it to the browser.
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_KEY=

# Optional: Stripe billing for Pro subscriptions. Without these, the upgrade
# flow shows "Payments not configured" and everyone stays on Free.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Public URL of the app (Stripe checkout redirects back here). Defaults to
# the request host if unset.
APP_URL=
